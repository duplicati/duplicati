<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "https://specifications.freedesktop.org/dbus/introspect-latest.dtd">

<node>
  <interface name="org.freedesktop.Secret.Prompt">
    <method name="Prompt">
      <arg name="window_id" type="s" direction="in" />
    </method>

    <method name="Dismiss"></method>

    <signal name="Completed">
      <arg name="dismissed" type="b" />
      <arg name="result" type="v" />
    </signal>
  </interface>
</node>
