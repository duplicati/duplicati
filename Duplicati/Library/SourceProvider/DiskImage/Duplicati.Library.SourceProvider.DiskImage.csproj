<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Duplicati.Library.SourceProvider.DiskImage</RootNamespace>
    <Copyright>Copyright © 2026 Team Duplicati, MIT license</Copyright>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Interface\Duplicati.Library.Interface.csproj" />
    <ProjectReference Include="..\..\Common\Duplicati.Library.Common.csproj" />
    <ProjectReference Include="..\..\Utility\Duplicati.Library.Utility.csproj" />
    <ProjectReference Include="..\..\Localization\Duplicati.Library.Localization.csproj" />
    <ProjectReference Include="..\..\Logging\Duplicati.Library.Logging.csproj" />
    <ProjectReference Include="..\..\Snapshots\Duplicati.Library.Snapshots.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.3" />
  </ItemGroup>

  <!-- Native libraries -->
  <ItemGroup>
    <!-- Windows -->
    <PackageReference Include="Vanara.PInvoke.Kernel32" Version="5.0.7" />
    <!-- Mac -->
    <ContentWithTargetPath Include="$(ProjectDir)NativeLibraryWrappers/libSystem_wrapper.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>runtimes/osx/native/libSystem_wrapper.dylib</TargetPath>
    </ContentWithTargetPath>
    <!-- x86 Linux -->
    <ContentWithTargetPath Include="$(ProjectDir)NativeLibraryWrappers/libc_wrapper_x86.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>runtimes/linux-x86/native/libc_wrapper.so</TargetPath>
    </ContentWithTargetPath>
    <!-- x64 Linux -->
    <ContentWithTargetPath Include="$(ProjectDir)NativeLibraryWrappers/libc_wrapper_x86_64.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>runtimes/linux-x64/native/libc_wrapper.so</TargetPath>
    </ContentWithTargetPath>
    <!-- ARM32 Linux -->
    <ContentWithTargetPath Include="$(ProjectDir)NativeLibraryWrappers/libc_wrapper_arm32.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>runtimes/linux-arm/native/libc_wrapper.so</TargetPath>
    </ContentWithTargetPath>
    <!-- ARM64 Linux -->
    <ContentWithTargetPath Include="$(ProjectDir)NativeLibraryWrappers/libc_wrapper_arm64.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>runtimes/linux-arm64/native/libc_wrapper.so</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>

  <!-- Allow the Unit tests to be able to see internal types. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Duplicati.UnitTest" />
  </ItemGroup>

</Project>
